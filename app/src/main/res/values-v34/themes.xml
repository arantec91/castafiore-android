<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema específico para QueueActivity en Android 14+ (API 34+) -->
    <style name="Theme.Castafiore.Queue" parent="Theme.Castafiore">
        <!-- Forzar barras del sistema completamente opacas para API 34+ -->
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Configuración específica para Android 14+ -->
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Forzar comportamiento tradicional -->
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBarOverlay">false</item>

        <!-- Configuración de fondo para evitar transparencias -->
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
    </style>
</resources>
