<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos para botones -->
    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Estilo para FloatingActionButton -->
    <style name="FloatingActionButton.Primary" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/text_on_primary</item>
    </style>

    <!-- Estilos para TextInputLayout -->
    <style name="TextInputLayout.Primary" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Estilo para AppBarLayout -->
    <style name="AppBarLayout.Primary" parent="Widget.MaterialComponents.AppBarLayout.Primary">
        <item name="android:background">@color/background_primary</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Estilo para Toolbar -->
    <style name="Toolbar.Primary" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/background_primary</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
    </style>

    <!-- Estilo para BottomNavigationView - Modo oscuro -->
    <style name="BottomNavigationView.Primary" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/dark_surface</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="itemRippleColor">@color/primary_alpha_24</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Estilo para CardView -->
    <style name="CardView.Primary" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <!-- Estilo para Switch -->
    <style name="Switch.Primary" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/primary</item>
        <item name="trackTint">@color/primary_light</item>
    </style>

    <!-- Estilo para ProgressBar -->
    <style name="ProgressBar.Primary" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/primary</item>
        <item name="android:progressBackgroundTint">@color/surface_variant</item>
    </style>

    <!-- Estilo para TabLayout -->
    <style name="TabLayout.Primary" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@color/background_primary</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabRippleColor">@color/primary_light</item>
    </style>

    <!-- Estilo para Chip -->
    <style name="Chip.Primary" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="checkedIconTint">@color/primary</item>
    </style>

    <!-- Dialog: Apariencia de forma reutilizable -->
    <style name="ShapeAppearance.Castafiore.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Dialog: Tipografías -->
    <style name="TextAppearance.Castafiore.AlertDialog.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Castafiore.AlertDialog.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Dialog: Botones -->
    <style name="Widget.Castafiore.AlertDialog.Button.Base" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="rippleColor">@color/primary_alpha_24</item>
    </style>
    <style name="Widget.Castafiore.AlertDialog.Button.Positive" parent="Widget.Castafiore.AlertDialog.Button.Base" />
    <style name="Widget.Castafiore.AlertDialog.Button.Negative" parent="Widget.Castafiore.AlertDialog.Button.Base" />
    <style name="Widget.Castafiore.AlertDialog.Button.Neutral" parent="Widget.Castafiore.AlertDialog.Button.Base" />

    <!-- Overlay global para MaterialAlertDialog -->
    <style name="ThemeOverlay.Castafiore.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Márgenes alrededor del fondo del diálogo -->
        <item name="backgroundInsetStart">16dp</item>
        <item name="backgroundInsetTop">16dp</item>
        <item name="backgroundInsetEnd">16dp</item>
        <item name="backgroundInsetBottom">16dp</item>

        <!-- Forma redondeada -->
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Castafiore.Medium</item>

        <!-- Colores de superficie -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>

        <!-- Tipografías personalizadas -->
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Castafiore.AlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Castafiore.AlertDialog.Body</item>

        <!-- Estilos de botones -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Castafiore.AlertDialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Castafiore.AlertDialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Castafiore.AlertDialog.Button.Neutral</item>
    </style>

    <!-- Overlay seguro para AlertDialog de AppCompat (fallback) -->
    <style name="ThemeOverlay.Castafiore.AlertDialog.AppCompat" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <!-- Fondo redondeado y colores -->
        <item name="android:windowBackground">@drawable/bg_alert_dialog_castafiore</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Animaciones de ventana específicas para PlayerActivity -->
    <style name="Animation.Castafiore.Player" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_up</item>
        <item name="android:activityOpenExitAnimation">@anim/hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/hold</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_down</item>
    </style>

    <!-- Tema específico para PlayerActivity con animaciones de entrada/salida -->
    <style name="Theme.Castafiore.Player" parent="Theme.Castafiore">
        <item name="android:windowAnimationStyle">@style/Animation.Castafiore.Player</item>
    </style>
</resources>
