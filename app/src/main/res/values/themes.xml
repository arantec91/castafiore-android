<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal unificado - Modo oscuro con color principal #FF2D55 -->
    <style name="Theme.Castafiore" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Colores de superficie y fondo - MODO OSCURO -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/dark_on_surface_variant</item>

        <!-- Colores de error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Fondo de ventana - MODO OSCURO -->
        <item name="android:windowBackground">@color/dark_background</item>

        <!-- Colores de texto - MODO OSCURO -->
        <item name="android:textColorPrimary">@color/dark_on_surface</item>
        <item name="android:textColorSecondary">@color/dark_on_surface_variant</item>

        <!-- Barra de estado y navegación - MODO OSCURO -->
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Outline para modo oscuro -->
        <item name="colorOutline">@color/dark_outline</item>

        <!-- Control highlights para modo oscuro -->
        <item name="colorControlHighlight">@color/primary_alpha_12</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlNormal">@color/dark_on_surface_variant</item>

        <!-- Bottom navigation color -->
        <item name="bottomNavigationStyle">@style/BottomNavigationView.Primary</item>

        <!-- Estilo global para MaterialAlertDialog -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Castafiore.AlertDialog</item>
        <!-- Fallback para AlertDialog de AppCompat -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Castafiore.AlertDialog.AppCompat</item>
    </style>

    <!-- Tema específico para QueueActivity que fuerza barras opacas en API 36 -->
    <style name="Theme.Castafiore.Queue" parent="Theme.Castafiore">
        <!-- Forzar barras del sistema completamente opacas -->
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Deshabilitar edge-to-edge completamente -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">never</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Configuración adicional para API 36 -->
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Configuración específica para Android 14+ -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>