<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground"
    android:minHeight="64dp">

    <!-- Album art -->
    <ImageView
        android:id="@+id/ivAlbumArt"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_album_placeholder"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:background="@drawable/rounded_corner_4dp"
        android:contentDescription="@string/song_cover" />

    <!-- Song info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_primary"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Bohemian Rhapsody" />

        <TextView
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            tools:text="Queen" />

    </LinearLayout>

    <!-- Drag handle (movido al final) -->
    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/text_secondary"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null" />

</LinearLayout>
