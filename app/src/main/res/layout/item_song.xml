<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingHorizontal="0dp"
    android:paddingVertical="12dp">

    <!-- Portada de la canción -->
    <ImageView
        android:id="@+id/ivSongCover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/song_cover"
        tools:src="@drawable/ic_music_note" />

    <!-- Información de la canción -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="normal"
            tools:text="Song Title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Contenedor del indicador de descarga: circular o icono descargado -->
            <FrameLayout
                android:id="@+id/containerIconDownload"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <!-- Icono de descarga (visible solo si la canción está descargada) -->
                <ImageView
                    android:id="@+id/ivDownloaded"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/download_to_device"
                    android:src="@drawable/ic_download"
                    app:tint="@color/primary"
                    android:visibility="gone" />

                <!-- Indicador de progreso circular (aparece en lugar del icono mientras descarga) -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/cpiDownload"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:indicatorSize="18dp"
                    app:trackThickness="2dp"
                    app:indicatorInset="0dp"
                    app:indicatorDirectionCircular="clockwise"
                    app:trackColor="@color/text_secondary"
                    app:indicatorColor="@color/primary"
                    app:showAnimationBehavior="inward"
                    app:hideAnimationBehavior="outward"
                    tools:indeterminate="true" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Artist Name" />
        </LinearLayout>

        <!-- Descarga: barra de progreso + estado -->
        <LinearLayout
            android:id="@+id/containerDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="6dp">

            <ProgressBar
                android:id="@+id/progressDownload"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progress="0"
                android:max="100"
                android:indeterminate="false"
                android:progressTint="@color/primary"
                tools:progress="42" />

            <TextView
                android:id="@+id/tvDownloadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                tools:text="Descargando 42%" />
        </LinearLayout>

    </LinearLayout>

    <!-- Botón más opciones -->
    <ImageButton
        android:id="@+id/btnSongMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_options"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/text_secondary" />

</LinearLayout>
